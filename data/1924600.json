.fastly.steamstatic.com/store_item_assets/steam/apps/1924600/extras/9a0c67746e5acedc65653f6d32ea8c48.poster.avif?t=1786648048\" width=\"780\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1924600/extras/9a0c67746e5acedc65653f6d32ea8c48.webm?t=1786648048\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1924600/extras/9a0c67746e5acedc65653f6d32ea8c48.mp4?t=1786648048\" type=\"video/mp4\"/></video></span><br/>Position powerful reinforcements like trenches, tanks, and bunkers to turn the tide of battle. These Battleworks can be the difference between a tactical advantage and a strategic retreat. How will you outplay the enemy team?\t\t\t\t\t\t</div>", "short_desc": "Free-to-play 4v4 War MOBA where you play as a Giant, lead an army of soldiers and deploy tactical structures known as \"Battleworks\" on a ravaged urban battlefield. Request access below for a chance to join future playtests", "header_image": "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1924600/aed7bf2522b0bae953184c425d1585733169e0b0/header.jpg?t=1786648048", "screenshots": [], "tags": ["Free to Play", "MOBA", "Multiplayer", "Strategy", "PvP", "Action"], "developers": "March of Giants Team", "publishers": "March of Giants Team", "release_date": "Coming soon", "price": "Coming Soon", "appid": "1924600", "review_type": "Recommended", "curator_desc": "27 August 2025 - Request Access", "yt_link": "https://youtu.be/PaTWARRtHuA", "first_seen": 1756245600.0, "review_rank": 1506}