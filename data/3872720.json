2720/extras/3af0052f57d2379eff0045e76d88ee95.webm?t=1783661164\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3872720/extras/3af0052f57d2379eff0045e76d88ee95.mp4?t=1783661164\" type=\"video/mp4\"/></video></span></p><h2 class=\"bb_tag\">Content</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Around 2\u20133 hours to complete</p></li><li><p class=\"bb_paragraph\">High replayability focused on performance</p></li><li><p class=\"bb_paragraph\">Achievements for 100% completion</p></li></ul><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"200\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3872720/extras/7cf8676c40686bdd931d0fc5128151f1.poster.avif?t=1783661164\" width=\"600\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3872720/extras/7cf8676c40686bdd931d0fc5128151f1.webm?t=1783661164\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3872720/extras/7cf8676c40686bdd931d0fc5128151f1.mp4?t=1783661164\" type=\"video/mp4\"/></video></span></p><h2 class=\"bb_tag\">Controls</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">Keyboard and gamepad support</p></li></ul><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"200\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3872720/extras/9d8383e56e1a9d85bafa99f7d0e05f6b.poster.avif?t=1783661164\" width=\"600\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3872720/extras/9d8383e56e1a9d85bafa99f7d0e05f6b.webm?t=1783661164\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3872720/extras/9d8383e56e1a9d85bafa99f7d0e05f6b.mp4?t=1783