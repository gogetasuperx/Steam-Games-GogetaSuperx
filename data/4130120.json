eamstatic.com/store_item_assets/steam/apps/4130120/extras/f120f593f58a554d8d43a58a3e662e25.webm?t=1787950544\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/f120f593f58a554d8d43a58a3e662e25.mp4?t=1787950544\" type=\"video/mp4\"/></video></span><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"256\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/c3ca0fd313a684c97527db96d3da9cb3.poster.avif?t=1787950544\" width=\"256\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/c3ca0fd313a684c97527db96d3da9cb3.webm?t=1787950544\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/c3ca0fd313a684c97527db96d3da9cb3.mp4?t=1787950544\" type=\"video/mp4\"/></video></span><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"256\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/ea64b5cd15b8f4fde6e4aed435d34b4f.poster.avif?t=1787950544\" width=\"256\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/ea64b5cd15b8f4fde6e4aed435d34b4f.webm?t=1787950544\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/ea64b5cd15b8f4fde6e4aed435d34b4f.mp4?t=1787950544\" type=\"video/mp4\"/></video></span></p><h2 class=\"bb_tag\">Pair DNA nucleotides <strong><u>A</u> (rapidfire)</strong>, <strong><u>C</u> (precision)</strong>, <strong><u>G</u> (spread)</strong>, <strong><u>T</u> (explosive)</strong> to discover <strong>70 hybrid bioweapons</strong>!</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"> <strong>Shotgun</strong> + <strong>Bomb</strong> mix explosives with spread for <strong>Blast Shotgun</strong>!</p></li><li><p class=\"bb_paragraph\"><strong>SMG</strong> + <strong>Pistol</strong> make an accurate, fast-firing <strong>Scout Rifle</strong>!</p></li><li><p class=\"bb_paragraph\"><strong>Blast Shotgun</strong> + <strong>Scout Rifle</strong> = something a <i>whole lot crazier</i>!</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" height=\"128\" src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/b626dabd3b5c6d1aef88e7dfa22332fa.avif?t=1787950544\" width=\"779\"/></span></p><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"256\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/cf6faad304b25a1cf2d4339b05f9cc54.poster.avif?t=1787950544\" width=\"256\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/cf6faad304b25a1cf2d4339b05f9cc54.webm?t=1787950544\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/cf6faad304b25a1cf2d4339b05f9cc54.mp4?t=1787950544\" type=\"video/mp4\"/></video></span><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" crossorigin=\"anonymous\" height=\"256\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/774e5f7bed4d7b0afd3391e46c6e61a7.poster.avif?t=1787950544\" width=\"256\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/774e5f7bed4d7b0afd3391e46c6e61a7.webm?t=1787950544\" type=\"video/webm; codecs=vp9\"/></video></span><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"256\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/24a5d63b3d8bb2dc3dfbf7e11ef2d485.poster.avif?t=1787950544\" width=\"256\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/24a5d63b3d8bb2dc3dfbf7e11ef2d485.webm?t=1787950544\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/24a5d63b3d8bb2dc3dfbf7e11ef2d485.mp4?t=1787950544\" type=\"video/mp4\"/></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"><strong>20-minute runs</strong> you can <strong>save &amp; resume</strong> at any time + improved <strong>Endless Mode</strong></p></li><li><p class=\"bb_paragraph\">Complete <strong>side objectives</strong> during runs for extra cash</p></li><li><p class=\"bb_paragraph\">Mine <strong>mineral deposits</strong> for resources</p></li><li><p class=\"bb_paragraph\">Trigger powerful <strong>Gadget</strong> active abilities</p></li><li><p class=\"bb_paragraph\"><strong>Test discovered weapons</strong> in the Database</p></li><li><p class=\"bb_paragraph\"><strong>100 bassy electronic tunes</strong> with in-game <strong>Jukebox</strong> accessible any time + <strong>Streamer Mode</strong></p></li><li><p class=\"bb_paragraph\"><strong>Auto aim/fire</strong> toggles</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" height=\"128\" src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/d46d42aad989134b6777129163d7d82e.avif?t=1787950544\" width=\"779\"/></span></p><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"256\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/79d397a0a76a9fa17adedf88ab4e13d3.poster.avif?t=1787950544\" width=\"256\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/4130120/extras/79d397a0a76a9fa17adedf