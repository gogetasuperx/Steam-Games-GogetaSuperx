 src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/ef70eb196bc9d0d45286062ce9cc19aa.mp4?t=1787244339\" type=\"video/mp4\"/></video></span></p><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"440\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/13e8f17427425ff1dc575c929c9f496c.poster.avif?t=1787244339\" width=\"1170\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/13e8f17427425ff1dc575c929c9f496c.webm?t=1787244339\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/13e8f17427425ff1dc575c929c9f496c.mp4?t=1787244339\" type=\"video/mp4\"/></video></span></p><p class=\"bb_paragraph\"></p><h2 class=\"bb_tag\"><strong>Key Features:</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"><strong>Handcrafted visuals</strong> inspired by the classic Disney animation and dark fantasy movies of the 80s</p></li><li><p class=\"bb_paragraph\"><strong>Cinematic moments</strong> with dramatic perspective shifts and environmental storytelling</p></li><li><p class=\"bb_paragraph\"><strong>Fun and engaing combat</strong>\u00a0</p></li><li><p class=\"bb_paragraph\"><strong>Environment puzzles</strong> </p></li><li><p class=\"bb_paragraph\">Various <strong>special abilities</strong></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><span class=\"bb_img_ctn\"><video autoplay=\"\" class=\"bb_img\" height=\"444\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/67ec88430229643363a67e8745f7afbc.poster.avif?t=1787244339\" width=\"1170\"><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/67ec88430229643363a67e8745f7afbc.webm?t=1787244339\" type=\"video/webm; codecs=vp9\"/><source src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/67ec88430229643363a67e8745f7afbc.mp4?t=1787244339\" type=\"video/mp4\"/></video></span></p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">We want to remind you of those classic stories, tales of monsters, castles, and forgotten legends you heard of as a child - <strong>retold through a dark, Slavic lens</strong>. We are inviting you into a world where danger hides behind beauty, and courage is the only way forward.</p><p class=\"bb_paragraph\"> </p><p class=\"bb_paragraph\">Become the hero you always dreamt of being.  </p><p class=\"bb_paragraph\" style=\"text-align: center\"> </p><h2 class=\"bb_tag\" style=\"text-align: center\"> </h2><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" height=\"42\" src=\"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/extras/2e7688f2eeff7b3a0860016c61db441b.webp?t=1787244339\" width=\"600\"/></span></p> </div>", "short_desc": "Experience a thrilling adventure through the dark and atmospheric world of medieval Croatia where an evil queen rules from the shadows and her haunted guardians await you. Venture into a dark fantasy tale wrapped in a cinematic action side-scroller with a unique 2.5D style.", "header_image": "https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/3106050/de64cdc8cabdc6dc5028b6d220c1934fa409837a/header.jpg?t=1787244339", "screenshots": [], "tags": ["Dark", "Atmospheric", "Indie", "Narrative", "Cinematic", "Emotional"], "developers": "Downtown Game Studio", "publishers": "Downtown Game Studio", "release_date": "Q1 2027", "price": "Coming Soon", "appid": "3106050", "review_type": "Informational", "curator_desc": "8 June 2026 - Demo", "yt_link": "https://youtu.be/Oaw1tzs2Bb4", "first_seen": 1780869600.0, "review_rank": 441}